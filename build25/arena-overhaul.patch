index 0000000..6be75fd
--- /dev/null
+++ b/AccountServer/backup.py
@@ -0,0 +1,15 @@
+"""Take a consistent SQLite backup, including committed WAL contents."""
+import argparse
+import sqlite3
+from pathlib import Path
+
+p=argparse.ArgumentParser()
+p.add_argument('source')
+p.add_argument('destination')
+a=p.parse_args()
+if Path(a.destination).exists():
+    raise SystemExit('Choose a new destination; backups are never overwritten.')
+with sqlite3.connect(Path(a.source).resolve().as_uri()+'?mode=ro',uri=True) as source:
+    with sqlite3.connect(a.destination) as target:
+        source.backup(target)
+print('Backup complete.')
