diff --git a/Web/bake24.gd b/Web/bake24.gd
new file mode 100644
index 0000000..576639f
--- /dev/null
+++ b/Web/bake24.gd
@@ -0,0 +1,26 @@
+extends SceneTree
+func _initialize():call_deferred("run")
+func run():
+	var surface=SubViewport.new();surface.size=Vector2i(4200,5872);surface.render_target_update_mode=SubViewport.UPDATE_ALWAYS;root.add_child(surface)
+	var g=load("res://Main.tscn").instantiate();surface.add_child(g);g.test_mode="bake20";g.baking20=true;g.bot_count=0;g.mode=1
+	root.content_scale_mode=Window.CONTENT_SCALE_MODE_DISABLED
+	root.size=Vector2i(480,320)
+	g.ui.visible=false;g.brand.visible=false
+	for m in range(5):
+		for stage in range(3 if m==4 else 1):
+			g.map_id=m;g.campaign.stage=[0,3,1][stage] if m==4 else 0;g.campaign.active=m==4;g.build_arena();g.camera_center=Vector2(2100,1400)
+			# Bastion draws one floor at a time; bake each floor separately then combine.
+			var output: Image
+			if m in [1,2]:
+				g.queue_redraw();await process_frame;await process_frame;await RenderingServer.frame_post_draw
+				output=surface.get_texture().get_image()
+				g.camera_center=Vector2(2100,4472);g.queue_redraw();await process_frame;await process_frame;await RenderingServer.frame_post_draw
+				var lower=surface.get_texture().get_image();output.blit_rect(lower,Rect2i(0,3072,4200,2800),Vector2i(0,3072))
+			else:
+				g.queue_redraw();await process_frame;await process_frame;await RenderingServer.frame_post_draw
+				output=surface.get_texture().get_image()
+			var key=str(m)+("-"+str(stage) if m==4 else "")
+			if g.WORLD.y<5872:output=output.get_region(Rect2i(0,0,4200,2800))
+			var err=output.save_png("res://assets/arena20-"+key+".png")
+			print("BAKED ",key," ",output.get_size()," status ",err)
+	quit()
