new file mode 100644
index 0000000..b7134b5
--- /dev/null
+++ b/AccountServer/recovery.py
@@ -0,0 +1,76 @@
+"""Recovery and opt-in remembered sessions. Store only hashes of random credentials."""
+import hashlib,hmac,secrets,time
+
+class Recovery:
+    def __init__(self, store):
+        self.s=store
+        store.db.executescript('''
+        CREATE TABLE IF NOT EXISTS recovery_codes(account TEXT NOT NULL, hash TEXT NOT NULL PRIMARY KEY);
+        CREATE INDEX IF NOT EXISTS recovery_account ON recovery_codes(account);
+        CREATE TABLE IF NOT EXISTS remembered_sessions(hash TEXT PRIMARY KEY, account TEXT NOT NULL, expires REAL NOT NULL, created REAL NOT NULL);
+        CREATE INDEX IF NOT EXISTS remembered_account ON remembered_sessions(account);
+        ''')
+        self.attempts={}
+    @staticmethod
+    def digest(value):return hashlib.sha256(value.encode()).hexdigest()
+    @staticmethod
+    def normalize(code):return str(code).replace('-','').replace(' ','').strip().upper()
+    def limited(self, ip, name='', refresh=False):
+        now=time.time()
+        self.attempts={k:v for k,v in self.attempts.items() if now-v[0]<600}
+        limits=[('refresh:'+ip,120)] if refresh else [('ip:'+ip,20),('name:'+str(name).casefold(),8)]
+        for key,limit in limits:
+            start,count=self.attempts.get(key,(now,0));self.attempts[key]=(start,count+1)
+            if count>=limit:raise ValueError('Too many recovery attempts. Wait ten minutes.')
+    def codes(self, aid):
+        values=[secrets.token_hex(12).upper() for _ in range(6)]
+        self.s.db.execute('DELETE FROM recovery_codes WHERE account=?',(aid,))
+        self.s.db.executemany('INSERT INTO recovery_codes VALUES(?,?)',[(aid,self.digest(v)) for v in values])
+        return ['-'.join(v[i:i+4] for i in range(0,len(v),4)) for v in values]
+    def remember(self, aid):
+        now=time.time();value=secrets.token_urlsafe(40)
+        self.s.db.execute('DELETE FROM remembered_sessions WHERE expires<=?',(now,))
+        self.s.db.execute('INSERT INTO remembered_sessions VALUES(?,?,?,?)',(self.digest(value),aid,now+30*86400,now))
+        self.s.db.execute('DELETE FROM remembered_sessions WHERE account=? AND hash NOT IN (SELECT hash FROM remembered_sessions WHERE account=? ORDER BY created DESC LIMIT 10)',(aid,aid))
+        return value
+    def session(self,aid):
+        self.s.sessions={k:v for k,v in self.s.sessions.items() if v[1]>time.time()}
+        value=secrets.token_urlsafe(32);self.s.sessions[self.digest(value)]=(aid,time.time()+43200);return value
+    def revoke(self,aid):
+        self.s.sessions={k:v for k,v in self.s.sessions.items() if v[0]!=aid}
+        self.s.tickets={k:v for k,v in self.s.tickets.items() if v[0]!=aid}
+        self.s.proofs={k:v for k,v in self.s.proofs.items() if v[0]!=aid and v[1]!=aid}
+        self.s.db.execute('DELETE FROM remembered_sessions WHERE account=?',(aid,))
+    def route(self,path,data,token,ip):
+        if path=='/session/refresh':
+            self.limited(ip,refresh=True)
+            digest=self.digest(str(data.get('refresh_token','')))
+            row=self.s.db.execute('SELECT * FROM remembered_sessions WHERE hash=?',(digest,)).fetchone()
+            if not row or row['expires']<=time.time():raise ValueError('Please log in again.')
+            with self.s.db:
+                self.s.db.execute('DELETE FROM remembered_sessions WHERE hash=?',(digest,))
+                refresh=self.remember(row['account'])
+            return dict(ok=True,token=self.session(row['account']),refresh_token=refresh,profile=self.s.profile(row['account'],True))
+        if path=='/recovery/create':
+            aid=self.s.auth(token);self.limited(ip,aid)
+            row=self.s.db.execute('SELECT salt,password FROM accounts WHERE id=?',(aid,)).fetchone()
+            password=str(data.get('password',''))
+            if not 8<=len(password)<=128:raise ValueError('Enter your current password.')
+            digest=hashlib.pbkdf2_hmac('sha256',password.encode(),bytes.fromhex(row['salt']),310000).hex()
+            if not hmac.compare_digest(digest,row['password']):raise ValueError('Enter your current password.')
+            with self.s.db:codes=self.codes(aid)
+            return dict(ok=True,recovery_codes=codes)
+        if path=='/password/reset':
+            name=str(data.get('name','')).strip();self.limited(ip,name)
+            password=str(data.get('password',''))
+            if not 8<=len(password)<=128:raise ValueError('Password: 8–128 characters.')
+            code=self.normalize(data.get('code',''))
+            row=self.s.db.execute('SELECT id FROM accounts WHERE name=?',(name,)).fetchone()
+            aid=row['id'] if row else ''
+            valid=self.s.db.execute('SELECT hash FROM recovery_codes WHERE account=? AND hash=?',(aid,self.digest(code))).fetchone()
+            if not valid:raise ValueError('Player name or recovery code is incorrect, expired or already used.')
+            salt=secrets.token_hex(16);digest=hashlib.pbkdf2_hmac('sha256',password.encode(),bytes.fromhex(salt),310000).hex()
+            with self.s.db:
+                self.s.db.execute('UPDATE accounts SET salt=?,password=? WHERE id=?',(salt,digest,aid));self.revoke(aid);codes=self.codes(aid)
+            return dict(ok=True,recovery_codes=codes,message='Password changed. All devices signed out. Save your new recovery codes; previous codes no longer work.')
+        return None
