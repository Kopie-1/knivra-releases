diff --git a/Game/audio.gd b/Game/audio.gd
index 9bf2fe8..754d76e 100644
--- a/Game/audio.gd
+++ b/Game/audio.gd
@@ -29,7 +29,7 @@ func _ready():
 	for i in range(32):
 		var voice=AudioStreamPlayer2D.new(); voice.bus="Effects"; voice.max_distance=1350; voice.attenuation=1.3; voice.panning_strength=3.0; add_child(voice); voices.append(voice)
 	music=loop_player("menu_music","Music"); loading=loop_player("loading_music","Music")
-	ambience=AudioStreamPlayer.new(); ambience.bus="Ambience"; add_child(ambience)
+	ambience=AudioStreamPlayer.new(); ambience.playback_type=AudioServer.PLAYBACK_TYPE_SAMPLE if OS.has_feature("web") else AudioServer.PLAYBACK_TYPE_STREAM; ambience.bus="Ambience"; add_child(ambience)
 	heartbeat=AudioStreamPlayer.new(); heartbeat.bus="Heartbeat"; heartbeat.stream=sample("heartbeat"); add_child(heartbeat)
 
 func sample(name: String):
@@ -40,13 +40,14 @@ func sample(name: String):
 	return cache[name]
 
 func loop_player(name: String,bus_name: String) -> AudioStreamPlayer:
-	var player=AudioStreamPlayer.new(); player.bus=bus_name; add_child(player)
+	var player=AudioStreamPlayer.new(); player.playback_type=AudioServer.PLAYBACK_TYPE_STREAM; player.bus=bus_name; add_child(player)
 	player.stream=sample(name).duplicate(); player.stream.loop=true; player.volume_db=-65; player.play()
 	return player
 
 func fade(player: AudioStreamPlayer,target: float,dt: float):
 	player.volume_db=move_toward(player.volume_db,target,dt*25)
-	player.stream_paused=player.volume_db<=-64 and target<=-64
+	var should_pause=player.volume_db<=-64 and target<=-64
+	if player.stream_paused!=should_pause:player.stream_paused=should_pause
 
 func _process(dt):
 	danger_pulse=maxf(0,danger_pulse-dt*4.0)
@@ -82,6 +83,7 @@ func play(name: String,p: Vector2,gain=0.0,pitch=1.0):
 	var family="glass_bits" if name.begins_with("glass_bits") else name
 	if now-int(recent.get(family,0))<(90 if family=="glass_bits" else 65 if name.begins_with("step_") or name.begins_with("shell") else 25): return
 	recent[family]=now
+	if name in ["bat_swing","bat_hit","hammer_swing","hammer_hit","wood_break","metal_break","barrel_warning","event25"]:name+=str(randi()%3)
 	var stream=sample(name)
 	if stream==null: return
 	for voice in voices:
@@ -89,7 +91,7 @@ func play(name: String,p: Vector2,gain=0.0,pitch=1.0):
 		voice.stream=stream; voice.position=p; voice.max_distance=radius
 		var clear=g.line_clear(ear,p)
 		voice.volume_db=gain+(-7 if p.distance_to(ear)>75 and not clear else 0)
-		voice.pitch_scale=pitch; voice.play(); return
+		voice.pitch_scale=pitch*randf_range(.97,1.03); voice.play(); return
 
 func ear_position() -> Vector2:
 	var a: Dictionary=g.actors.get(g.my_id(),{})
@@ -103,8 +105,8 @@ func audible_range(name: String) -> float:
 	return 1500.0
 
 func weapon(w: int,p: Vector2):
-	var names=["swing","swing2","swing","rifle","pistol","rocket","cloth","carbine","shotgun","smg","marksman"]
-	var sound=names[clampi(w,0,10)]
+	var names=["bat_swing","swing2","swing","rifle","pistol","rocket","cloth","carbine","shotgun","smg","marksman"]
+	var sound="rocket" if w==11 else names[clampi(w,0,10)]
 	if w==3 and randi()%2==0: sound="rifle2"
 	play(sound,p,-12 if w<3 else -8,randf_range(.975,1.025))
 
