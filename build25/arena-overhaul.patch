diff --git a/Game/arena25.gd b/Game/arena25.gd
new file mode 100644
index 0000000..652b739
--- /dev/null
+++ b/Game/arena25.gd
@@ -0,0 +1,215 @@
+extends RefCounted
+# Build 25 simulation state is owned by the authoritative arena process.
+var g
+var lamps: Array=[]
+var event_index=0
+var event_name="SCAVENGE / FIGHT / ADAPT"
+var event_until=0.0
+var blackout=false
+var shortage=false
+var bounty=0
+var next_event=90.0
+var rubble: Array=[]
+var revision=0
+var nav_dirty=false
+var dirty_regions: Array=[]
+const EVENTS=["POWER FAILURE","RARE DROP","LOCKDOWN","SUPPLY CACHE","HIGH VALUE TARGET","AMMO SHORTAGE","OVERLOAD","LAST CALL"]
+
+func reset(arena):
+	g=arena; lamps.clear(); rubble.clear(); event_index=0; next_event=90.0
+	event_name="SCAVENGE / FIGHT / ADAPT"; event_until=0; blackout=false; shortage=false; bounty=0; revision=0; nav_dirty=false;dirty_regions.clear()
+	for s in g.solids:
+		s.dead=false
+		s.max_health=180.0 if s.kind==5 else 420.0 if s.kind==4 else 140.0
+		s.health=s.max_health; s.fuse=-1.0; s.owner=0
+		s.breakable=s.kind in [3,4,5,6,7,8,9,10,12,13,14,17,18]
+		# Only explicitly marked short internal wall panels are breachable.
+		if s.kind==4:s.breakable=maxf(s.r.size.x,s.r.size.y)<=432
+	for d in g.doors:
+		d.health=220.0; d.dead=false; d.wedge=0; d.wedge_side=0.0
+	for room in g.rooms:
+		lamps.append({"p":room.r.get_center(),"health":36.0,"radius":maxf(room.r.size.x,room.r.size.y)*.65})
+	if lamps.is_empty():
+		for p in g.LAMPS:lamps.append({"p":p,"health":36.0,"radius":330.0})
+
+func state() -> Dictionary:
+	var objects=[]
+	for s in g.solids: objects.append([s.get("health",0),s.get("dead",false),s.get("fuse",-1)])
+	return {"objects":objects,"lamps":lamps,"event":event_name,"until":event_until,"blackout":blackout,"shortage":shortage,"bounty":bounty,"next":next_event,"revision":revision,"rubble":rubble}
+
+func receive(data: Dictionary):
+	var objects: Array=data.get("objects",[])
+	if objects.size()!=g.solids.size():return
+	for i in objects.size():
+		g.solids[i].health=objects[i][0];g.solids[i].dead=objects[i][1];g.solids[i].fuse=objects[i][2]
+	lamps=data.lamps;event_name=data.event;event_until=data.until;blackout=data.blackout;shortage=data.shortage;bounty=data.bounty;next_event=data.next;rubble=data.rubble;revision=data.revision
+
+func hurt(s: Dictionary,amount: float,owner: int,heavy=false):
+	if s.get("dead",false) or not s.get("breakable",false):return
+	if s.kind==4 and not heavy:return
+	s.health=maxf(0,s.health-amount);s.owner=owner;revision+=1
+	if s.kind==5:
+		if s.health<=s.max_health*.35 and s.fuse<0:s.fuse=1.4;g.sound_event("barrel_warning",s.r.get_center())
+		return
+	if s.health<=0:destroy(s)
+
+func destroy(s: Dictionary):
+	if s.dead:return
+	s.dead=true;revision+=1;nav_dirty=true;dirty_regions.append(s.r.grow(48))
+	var p: Vector2=s.r.get_center()
+	rubble.append({"p":p,"kind":s.kind,"size":s.r.size})
+	if rubble.size()>96:rubble.pop_front()
+	g.burst(p,g.AMBER,20,100);g.sound_event("wood_break" if s.kind==3 else "metal_break",p)
+	if s.kind==3 and g.noise.randf()<.45:g.pickups.append({"p":p,"kind":g.noise.randi_range(0,1),"cool":0.0})
+
+func hurt_door(d: Dictionary,amount: float):
+	if d.get("dead",false):return
+	d.health=maxf(0,float(d.get("health",220))-amount)
+	if d.health<=0:
+		d.dead=true;d.wedge=0;nav_dirty=true;dirty_regions.append(Rect2(d.h,Vector2.ZERO).expand(g.door_end(d)).grow(48));g.burst(g.door_center(d),g.AMBER,25,130);g.sound_event("wood_break",g.door_center(d))
+
+func wedge(id: int):
+	if not g.allow_action(id):return
+	var a: Dictionary=g.actors[id]
+	for d in g.doors:
+		if d.get("dead",false) or a.p.distance_to(g.door_center(d))>95:continue
+		var side=signf(Vector2.from_angle(d.base).cross(a.p-d.h))
+		if d.wedge!=0:
+			if d.wedge==id and side==d.wedge_side:d.wedge=0;a.wedges+=1
+			return
+		# A wedge is placed from within a room, never remotely through a wall.
+		if a.wedges<=0 or not g.rooms.any(func(room):return room.r.has_point(a.p)):return
+		d.wedge=id;d.wedge_side=side;d.angle=d.base;d.target=d.base;d.velocity=0;a.wedges-=1
+		g.sound_event("latch",a.p);return
+
+func breach(a: Dictionary):
+	if a.role!=2 or a.hp<=0 or a.cool>0 or a.anim>0 or a.reload>0:return
+	a.cool=1.1;a.anim=.65;a.duration=.65;a.pending=false;a.hammer_until=g.round_time+.65
+	melee(a,105.0,true);g.sound_event("hammer_swing",a.p)
+
+func melee(a: Dictionary,reach: float,heavy=false):
+	var direction=Vector2.from_angle(a.aim)
+	for d in g.doors:
+		var p=g.door_center(d)
+		if not d.get("dead",false) and a.p.distance_to(p)<reach and direction.dot((p-a.p).normalized())>.3:
+			hurt_door(d,115 if heavy else 24);g.sound_event("hammer_hit" if heavy else "bat_hit",p)
+	for s in g.solids:
+		var p: Vector2=s.r.get_center(); var near=Vector2(clampf(a.p.x,s.r.position.x,s.r.end.x),clampf(a.p.y,s.r.position.y,s.r.end.y))
+		if a.p.distance_to(near)<reach and direction.dot((p-a.p).normalized())>.3 and g.line_clear(a.p,near-direction*5):hurt(s,150 if heavy else 32,a.id,heavy)
+	if heavy:
+		for b in g.actors.values():
+			if b.hp>0 and g.hostile(a,b) and a.p.distance_to(b.p)<reach and direction.dot((b.p-a.p).normalized())>.4 and g.line_clear(a.p,b.p):g.damage(b,58,a.id)
+	for pane in g.panes:
+		var p=(pane.a+pane.b)*.5
+		if not pane.broken and a.p.distance_to(p)<reach and direction.dot((p-a.p).normalized())>.3:g.shatter_glass(pane,p,direction)
+
+func shoot_light(p: Vector2,amount: float) -> bool:
+	for lamp in lamps:
+		if lamp.health>0 and p.distance_to(lamp.p)<15:
+			lamp.health=maxf(0,lamp.health-amount)
+			if lamp.health==0:g.sound_event("glass_break0",p);g.burst(p,g.WHITE,12,90)
+			return true
+	return false
+
+func dark_at(p: Vector2) -> bool:
+	if blackout:return true
+	for lamp in lamps:
+		if lamp.health<=0 and p.distance_to(lamp.p)<lamp.radius:return true
+	return false
+
+func visible_to(a: Dictionary,p: Vector2) -> bool:
+	if not dark_at(p):return true
+	var distance=a.p.distance_to(p)
+	if distance<42:return true
+	return distance<220 and Vector2.from_angle(a.aim).dot((p-a.p).normalized())>.78 and g.line_clear(a.p,p)
+
+func tick(dt: float):
+	if g.round_time>=next_event:
+		trigger(EVENTS[event_index%EVENTS.size()]);event_index+=1;next_event+=85
+	if event_until>0 and g.round_time>=event_until:
+		blackout=false;shortage=false;bounty=0;event_until=0
+	for s in g.solids:
+		if s.get("fuse",-1)>0 and not s.dead:
+			s.fuse-=dt
+			if s.fuse<=0:
+				destroy(s);g.explode(s.r.get_center(),s.owner,230)
+	if nav_dirty:
+		for r in dirty_regions:
+			for y in range(maxi(0,int(r.position.y/g.NAV_CELL)),mini(g.nav.region.size.y,int(r.end.y/g.NAV_CELL)+1)):
+				for x in range(maxi(0,int(r.position.x/g.NAV_CELL)),mini(g.nav.region.size.x,int(r.end.x/g.NAV_CELL)+1)):
+					var cell=Vector2i(x,y);g.nav.set_point_solid(cell,g.blocked(g.nav.get_point_position(cell),20,true))
+		dirty_regions.clear();nav_dirty=false
+
+func trigger(kind: String):
+	event_name=kind;event_until=g.round_time+40
+	blackout=kind in ["POWER FAILURE","OVERLOAD"];shortage=kind=="AMMO SHORTAGE";bounty=0
+	if kind=="HIGH VALUE TARGET":
+		var best=-1
+		for a in g.actors.values():
+			if a.hp>0 and a.kills>best:best=a.kills;bounty=a.id
+	if kind=="LOCKDOWN":
+		for d in g.doors:
+			if not d.dead and d.wedge==0:d.target=d.base;d.angle=d.base;d.hold=20;d.lock_until=g.round_time+20
+	if kind in ["SUPPLY CACHE","RARE DROP","LAST CALL"]:
+		var sites=g.map_sites();var p=g.safe_spawn(sites[g.noise.randi_range(0,sites.size()-1)],0)
+		if kind=="SUPPLY CACHE":
+			for i in range(4):g.pickups.append({"p":g.safe_spawn(p+Vector2(i*40,0),0),"kind":i%2,"cool":0.0})
+		else:
+			g.dropped.append({"p":p,"weapon":11,"mag":4,"reserve":8,"spawn":-1,"life":120.0,"rare":true})
+		g.burst(p,g.TEAL,35,130)
+	g.sound_event("event25",g.camera_center)
+
+func draw():
+	for bit in rubble:
+		if not g.world_view.has_point(bit.p):continue
+		for i in range(12):
+			var p=bit.p+Vector2(sin(i*17.3)*bit.size.x*.65,cos(i*8.1)*bit.size.y*.65)
+			g.line(p,p+Vector2.from_angle(i*2.3)*15,Color("786957"),4)
+	for s in g.solids:
+		if s.get("dead",false) or not s.get("breakable",false) or not g.world_view.intersects(s.r):continue
+		if s.health<s.max_health:
+			var p: Vector2=s.r.get_center()
+			g.line(s.r.position+Vector2(5,5),p,Color("17212b"),3);g.line(p,s.r.end-Vector2(5,5),Color("17212b"),2)
+		if s.fuse>0:g.draw_circle(s.r.get_center(),12+sin(g.round_time*25)*5,Color("ff683c"))
+		if s.kind==4:g.line(s.r.position,s.r.end,Color(.9,.65,.3,.5),2)
+	for lamp in lamps:
+		if not g.world_view.has_point(lamp.p):continue
+		g.draw_rect(Rect2(lamp.p-Vector2(13,5),Vector2(26,10)),Color("1d2933"))
+		g.line(lamp.p-Vector2(10,0),lamp.p+Vector2(10,0),g.TEAL if lamp.health>0 and not blackout else g.MUTED,4)
+	for d in g.doors:
+		if d.get("wedge",0)!=0 and not d.dead:g.draw_circle(g.door_center(d),7,g.AMBER)
+	for a in g.actors.values():
+		if a.get("hammer_until",0)>g.round_time:
+			var t=Transform2D(a.aim+sin((a.hammer_until-g.round_time)*PI/.65)*1.3,a.p)
+			g.line(t*Vector2(5,12),t*Vector2(70,12),Color("9c774b"),5)
+			g.line(t*Vector2(65,-1),t*Vector2(65,25),Color("a5b7bc"),13)
+	if bounty!=0 and g.actors.has(bounty):g.draw_arc(g.actors[bounty].p,40,0,TAU,32,g.AMBER,3)
+
+func detail():
+	for item in g.dropped:
+		if item.weapon==11 and g.world_view.has_point(item.p):
+			g.draw_arc(item.p,34+sin(g.round_time*3)*4,0,TAU,32,g.TEAL,2)
+			g.text("RARE / ARC",item.p+Vector2(-27,-42),12,g.TEAL)
+	# Flush props remain outside navigation and clear shooting lanes.
+	for i in range(g.rooms.size()):
+		var room=g.rooms[i];var r: Rect2=room.r
+		if not g.world_view.intersects(r):continue
+		var p=r.position+Vector2(30,30)
+		g.rect(Rect2(p,Vector2(110,52)),Color("192c35"))
+		g.line(p,p+Vector2(110,0),g.AMBER,4)
+		g.text(["SAFETY FIRST","POWER CONTROL","AUTHORIZED ONLY","KEEP CLEAR"][i%4],p+Vector2(6,22),10,g.WHITE)
+		g.text("KNIVRA / FACILITIES",p+Vector2(6,40),8,g.TEAL)
+		# Cable conduit and ventilation grates mounted along room edges.
+		g.line(r.position+Vector2(15,110),r.position+Vector2(15,r.size.y-30),Color("788b8e"),4)
+		var vent=Rect2(r.position+Vector2(r.size.x-83,27),Vector2(52,35))
+		g.rect(vent,Color("182c33"))
+		for n in range(6):g.line(vent.position+Vector2(4,4+n*5),vent.position+Vector2(48,4+n*5),Color("647a81"),2)
+	for s in g.solids:
+		if s.get("dead",false) or not g.world_view.intersects(s.r):continue
+		if s.kind in [7,8,9]:
+			var r: Rect2=s.r.grow(-8)
+			for x in range(int(r.position.x),int(r.end.x)-12,18):
+				g.rect(Rect2(x,r.position.y+8,12,22),Color("849489"));g.line(Vector2(x+2,r.position.y+14),Vector2(x+10,r.position.y+14),g.INK,2)
+		if s.kind in [1,2,5]:
+			var p: Vector2=s.r.position+Vector2(12,s.r.size.y+12)
+			for n in range(6):g.line(p+Vector2(n*12,0),p+Vector2(n*12+8,8),Color(.85,.63,.25,.65),3)
