+extends SceneTree
+const P=preload("res://presentation21.gd")
+func _initialize():call_deferred("run")
+func run():
+	var g=load("res://Main.tscn").instantiate();root.add_child(g);g.test_mode="test21";g.set_process(false)
+	var count=0
+	for w in range(11):
+		for side in ["top","under"]:
+			var texture=load("res://assets/weapon21-%d-%s.svg"%[w,side]);assert(texture!=null and texture.get_width()>500);count+=1
+	for ttl in [15.0,90.0]:
+		var item={"p":Vector2(1900,1400),"weapon":7,"life":ttl,"visual_life":ttl,"mag":17,"reserve":31}
+		var original=item.duplicate(true);var first=P.drop_pose(item);assert(not first.settled);assert(item==original);count+=2
+		item.life=ttl-1.15;var settled=P.drop_pose(item);assert(settled.settled and settled.p==item.p and settled.height==0);count+=1
+		item.life-=3;assert(P.drop_pose(item)==settled);count+=1
+	for x in range(30):
+		var i={"p":Vector2(x*53,1800),"weapon":x%11,"life":13.86,"visual_life":15.0}
+		var before=P.drop_pose(i);i.life=13.84;var after=P.drop_pose(i)
+		assert(before.p.distance_to(after.p)<.1 and absf(cos(before.roll)-cos(after.roll))<.01);count+=1
+	g.mode=1;g.bot_count=0;g.start_solo();g.match_warmup=0;g.test_arm(g.actors[1],7,17,31);g.drop_weapon(1)
+	var drop=g.dropped[-1];assert(drop.mag==17 and drop.reserve==31 and drop.visual_life==90);count+=1
+	g.weapon_interact(1);assert(g.actors[1].weapon==7 and g.actors[1].mag[7]==17);count+=1
+	print("PASS ",count," Build 21 resource, drop pose continuity, immutable presentation and ammo/pickup checks")
+	quit()
