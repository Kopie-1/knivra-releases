@@ -0,0 +1,32 @@
+"""Local-only moderation for the owner of the account database."""
+import argparse
+import json
+import sqlite3
+import time
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--data',required=True)
+    sub=parser.add_subparsers(dest='command',required=True)
+    sub.add_parser('reports')
+    mute=sub.add_parser('mute'); mute.add_argument('name'); mute.add_argument('--minutes',type=int,default=60)
+    unmute=sub.add_parser('unmute'); unmute.add_argument('name')
+    args=parser.parse_args()
+    db=sqlite3.connect('file:'+args.data+'?mode=rw',uri=True); db.row_factory=sqlite3.Row
+    try:
+        if args.command=='reports':
+            rows=db.execute('SELECT r.id,r.reason,r.created,a.name AS reporter,b.name AS sender,m.body FROM reports r LEFT JOIN messages m ON m.id=r.message LEFT JOIN accounts a ON a.id=r.reporter LEFT JOIN accounts b ON b.id=m.sender ORDER BY r.id DESC LIMIT 100')
+            for row in rows: print(json.dumps(dict(row),ensure_ascii=True))
+            return
+        row=db.execute('SELECT id FROM accounts WHERE name=?',(args.name,)).fetchone()
+        if not row: parser.error('Player not found.')
+        minutes=args.minutes if args.command=='mute' else 0
+        if not 0<=minutes<=10080: parser.error('Minutes must be between 0 and 10080.')
+        with db:
+            db.execute('UPDATE accounts SET muted_until=? WHERE id=?',(time.time()+minutes*60 if minutes else 0,row['id']))
+            db.execute('INSERT INTO moderation(account,reason,action,created) VALUES(?,?,?,?)',(row['id'],'operator review',f'mute:{minutes} minutes' if minutes else 'unmute',time.time()))
+        print('Chat restriction updated for '+args.name)
+    finally: db.close()
+
+if __name__=='__main__': main()
