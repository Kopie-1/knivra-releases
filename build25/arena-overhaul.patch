+extends SceneTree
+var checks=0
+var failed=0
+func check(ok: bool,label: String):
+ checks+=1
+ if not ok:failed+=1;print("FAIL ",label)
+func _initialize():run.call_deferred()
+func run():
+ var g=load("res://Main.tscn").instantiate();root.add_child(g);g.test_mode="test25";g.set_physics_process(false)
+ await process_frame
+ for map in range(4):
+  g.map_id=map;g.mode=1;g.bot_count=4;g.start_solo();g.match_warmup=0
+  check(g.actors.size()==5,"actor count")
+  var a=g.actors[1]
+  for role in range(3):
+   g.Roles.initialize(a,role)
+   check(a.wedges==1 and not a.medkit,"scavenged medical supplies")
+   check(a.armor==[35,15,90][role],"class armor")
+  var crate={}
+  for s in g.solids:
+   if s.get("breakable",false) and s.kind!=4 and s.kind!=5:crate=s;break
+  if not crate.is_empty():
+   var old=crate.health
+   g.overhaul.hurt(crate,10,1);check(crate.health==old-10 and not crate.dead,"progressive damage")
+   g.overhaul.hurt(crate,1000,1);check(crate.dead,"destroy prop")
+   check(not g.blocked(crate.r.get_center(),2,true),"destroyed prop collision removed")
+  var wall={}
+  for s in g.solids:
+   if s.kind==4 and s.get("breakable",false):wall=s;break
+  if not wall.is_empty():
+   var hp=wall.health;g.overhaul.hurt(wall,999,1);check(wall.health==hp,"wall resists bullets")
+   g.overhaul.hurt(wall,999,1,true);check(wall.dead,"heavy wall breach")
+  for s in g.solids:
+   if s.kind==5:
+    g.overhaul.hurt(s,200,1);check(not s.dead and s.fuse>0,"barrel warning before blast")
+    g.overhaul.tick(1.5);check(s.dead,"barrel delayed blast");break
+  if not g.doors.is_empty():
+   var d=g.doors[0];g.overhaul.hurt_door(d,40);check(not d.dead and d.health==180,"door multi hit")
+   g.overhaul.hurt_door(d,200);check(d.dead,"door breach")
+  if map==0:
+   g.Roles.initialize(a,2);a.invuln=0;a.cool=0
+   var d=g.doors[0];d.dead=false;d.health=220;a.p=g.door_center(d)+Vector2(0,35)
+   g.overhaul.wedge(1);check(d.wedge==1 and a.wedges==0,"wedge placed inside consumes item")
+   var old=a.p;g.move_actor(a,Vector2(0,-35));check(a.p==old,"wedged door blocks movement")
+   g.overhaul.wedge(1);check(d.wedge==0 and a.wedges==1,"owner removes wedge from same side")
+   a.p=g.door_center(d)+Vector2(0,-35);g.overhaul.wedge(1);check(d.wedge==0,"outside cannot place wedge")
+   var armor=a.armor;var hp=a.hp;g.damage(a,20,-1);check(a.armor<armor and a.hp>hp-20,"finite armor absorbs partial damage")
+   g.test_arm(a,11);a.aim=0;g.release(a);check(g.shots[-1].kind==2 and g.shots[-1].weapon==11,"arc launcher bouncing timed projectile")
+  if not g.overhaul.lamps.is_empty():
+   var l=g.overhaul.lamps[0];g.overhaul.shoot_light(l.p,40);check(l.health==0 and g.overhaul.dark_at(l.p),"light destroyed darkness")
+  for event in g.overhaul.EVENTS:
+   g.overhaul.trigger(event);check(g.overhaul.event_name==event,"event "+event)
+  check(g.dropped.any(func(item):return item.weapon==11),"rare weapon drop")
+  g.overhaul.trigger("POWER FAILURE");a.aim=0;a.p=g.safe_spawn(Vector2(300,1400),1)
+  check(not g.overhaul.visible_to(a,a.p+Vector2(-120,0)),"flashlight rear concealment")
+  check(not g.overhaul.visible_to(a,a.p+Vector2(350,0)),"flashlight narrow range")
+  var encoded=g.pack_snapshot();var decoded=bytes_to_var(encoded.decompress_dynamic(1048576,FileAccess.COMPRESSION_DEFLATE))
+  check(decoded.size()==13 and decoded[12].blackout,"snapshot world state")
+  g.overhaul.blackout=false;g.overhaul.receive(decoded[12]);check(g.overhaul.blackout,"remote darkness state")
+  g.round_time=719;g.result="";g.simulate(2);check(not g.result.is_empty(),"12 minute time limit")
+  g.start_solo();check(g.overhaul.revision==0 and g.overhaul.event_index==0,"round reset")
+  g.match_warmup=0
+  for i in range(1200):g.simulate(1.0/60)
+  check(g.actors.values().all(func(actor):return is_finite(actor.p.x) and is_finite(actor.p.y)),"20 seconds simulation stable")
+ print("BUILD25 ",checks," checks / ",failed," failures")
+ g.queue_free();await process_frame;quit(1 if failed else 0)
