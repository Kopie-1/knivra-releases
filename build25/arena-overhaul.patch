+   if not row:return dict(ok=True)
+   order=dict(row)
+  kind=event.get('event_type')
+  if kind=='PAYMENT.CAPTURE.COMPLETED':self.fulfill(order,self.paypal.call('GET','/v2/checkout/orders/'+order['paypal_order']))
+  elif kind in ('PAYMENT.CAPTURE.REFUNDED','PAYMENT.CAPTURE.REVERSED'):
+   with self.store.lock,self.store.db:
+    self.store.db.execute("UPDATE cosmetic_orders SET state=?,updated=? WHERE id=?",('refunded' if kind.endswith('REFUNDED') else 'reversed',time.time(),order['id']));self.store.db.execute('DELETE FROM cosmetic_grants WHERE source=?',(order['id'],))
