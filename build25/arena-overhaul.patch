+ float near=1.0-smoothstep(25.0,48.0,dist);
+ float muzzle=flash*(1.0-smoothstep(60.0,280.0,dist));
+ COLOR=vec4(0.005,0.012,0.022,dark*(1.0-max(max(cone,near),muzzle)));
