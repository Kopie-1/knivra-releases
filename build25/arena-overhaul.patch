+import os
+import tempfile
+import threading
+import time
+import unittest
+import json
+import urllib.request
+from server import Store, Handler, ThreadingHTTPServer
+
+
+class AccountsTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.temp.name, 'accounts.sqlite3')
+        self.store = Store(self.path, server_key="test-trusted-server-key-32-characters")
+        self.a = self.store.route('/signup', {'name':'Alpha','password':'test-pass-alpha'})
+        self.b = self.store.route('/signup', {'name':'Bravo','password':'test-pass-bravo'})
+
+    def tearDown(self):
+        self.store.db.close()
+        self.temp.cleanup()
+
+    def call(self, endpoint, body=None, actor=None):
+        return self.store.route(endpoint, body or {}, (actor or self.a)['token'], server_key='test-trusted-server-key-32-characters')
+
+    def match(self):
+        ticket = self.call('/ticket',actor=self.b)['ticket']
+        proof = self.call('/verify',{'ticket':ticket})['proof']
+        mid = self.call('/matches/start',{'mode':'DEATHMATCH','proofs':[proof]})['match_id']
+        with self.store.db:
+            self.store.db.execute('UPDATE matches SET started=? WHERE id=?',(time.time()-60,mid))
+        return mid
+
+    def results(self, mid):
