+import unittest
+from matchmaking import Matchmaker
+from server import Store
+
+class MatchmakingTests(unittest.TestCase):
+    def setUp(self):
+        self.now=0
+        self.m=Matchmaker('downloads.knivra.ca:27844',lambda:self.now)
+    def beat(self,mode='TEAM DEATHMATCH',players=None,state='lobby'):
+        return self.m.heartbeat(dict(build=13,mode=mode,players=players or [],state=state))
+    def find(self,name='a',mode='TEAM DEATHMATCH'):
+        return self.m.find(name*32,dict(build=13,mode=mode))
+    def test_offline_waits(self):
+        self.assertFalse(self.find()['server_online'])
+    def test_matching_lobby_reserves(self):
+        self.beat(); self.assertEqual(self.find()['status'],'ready')
+        self.assertEqual(len(self.m.reservations),1)
+        self.find(); self.assertEqual(len(self.m.reservations),1)
+    def test_switch_requires_server_confirmation(self):
+        self.beat(); self.assertEqual(self.find(mode='CAPTURE THE FLAG')['status'],'waiting')
+        self.assertEqual(self.beat()['mode'],'CAPTURE THE FLAG')
+        self.beat('CAPTURE THE FLAG'); self.assertEqual(self.find(mode='CAPTURE THE FLAG')['status'],'ready')
+    def test_busy_waits(self):
+        self.beat(state='playing'); self.assertEqual(self.find()['status'],'waiting')
+    def test_capacity(self):
+        self.beat()
+        for name in 'abcdefg': self.assertEqual(self.find(name)['status'],'ready')
+        self.assertEqual(self.find('h')['status'],'waiting')
+        self.m.cancel('a'*32); self.assertEqual(self.find('h')['status'],'ready')
+    def test_connected_consumes_reservation(self):
+        self.beat(); self.find(); self.beat(players=['a'*32])
+        self.assertEqual(len(self.m.reservations),0)
+        self.assertEqual(self.find()['status'],'connected')
+    def test_offline_expires_leases(self):
+        self.beat(); self.find(); self.now=13
+        self.assertFalse(self.find()['server_online']); self.assertFalse(self.m.reservations)
+    def test_abandoned_queue_expires(self):
+        self.find(); self.now=31; self.beat(); self.assertFalse(self.m.waiting)
+    def test_reservations_expire(self):
+        self.beat(); self.find()
+        for t in [10,20,31]: self.now=t; self.beat()
+        self.assertFalse(self.m.reservations)
+    def test_no_mode_change_with_players(self):
+        self.beat(players=['z'*32]); self.find(mode='DEATHMATCH')
+        self.assertEqual(self.beat(players=['z'*32])['mode'],'TEAM DEATHMATCH')
+    def test_invalid_build(self):
+        with self.assertRaises(ValueError):self.m.find('a',dict(build=12,mode='DEATHMATCH'))
+    def test_server_auth_and_player_auth(self):
+        s=Store(':memory:',server_key='k'*48)
+        try:
+            with self.assertRaises(ValueError):s.route('/matchmaking/heartbeat',dict(build=13,mode='DEATHMATCH',state='lobby',players=[]),server_key='bad')
+            with self.assertRaises(ValueError):s.route('/matchmaking/find',dict(build=13,mode='DEATHMATCH'))
+            self.assertTrue(s.route('/matchmaking/heartbeat',dict(build=13,mode='DEATHMATCH',state='lobby',players=[]),server_key='k'*48)['ok'])
+        finally:s.db.close()
+
+if __name__=='__main__':unittest.main()
