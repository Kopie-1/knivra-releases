+        self.assertGreater(reply['profile']['ranged_bias'],.5)
+        self.assertEqual(self.call('/cosmetic',{'cosmetic':'visor'})['profile']['cosmetic'],'visor')
+        self.store.db.close(); self.store=Store(self.path, server_key="test-trusted-server-key-32-characters")
+        new=self.store.route('/login',dict(name='Alpha',password='test-pass-alpha'))
+        self.assertEqual(new['profile']['xp'],1300)
+        self.assertEqual(new['profile']['cosmetic'],'visor')
+
+    def test_locked_cosmetic_rejected(self):
+        with self.assertRaises(ValueError): self.call('/cosmetic',{'cosmetic':'halo'})
+        self.assertEqual(self.call('/me')['profile']['cosmetic'],'standard')
+
+    def test_duplicate_result_cannot_award_twice(self):
+        mid=self.match(); self.call('/matches/finish',self.results(mid))
+        with self.assertRaises(ValueError): self.call('/matches/finish',self.results(mid))
