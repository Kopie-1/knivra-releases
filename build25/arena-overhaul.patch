+"""Persistent friends and moderated, age-gated direct messages for Knivra."""
+import datetime
+import re
+import time
+import unicodedata
+
+TAGLINES = ('Pick up a fight', 'Hold the line', 'Never camp twice', 'Yard regular', 'Mall menace')
+PROFANITY = re.compile(r'\b(?:fuck\w*|shit\w*|bitch\w*|asshole\w*|cunt\w*)\b', re.I)
+ABUSE = re.compile(r'\b(?:kill yourself|kys|go die|you deserve to die|i will kill you|i hate you|you are worthless|fuck you|you are an idiot|you are stupid|nigg\w*|fagg\w*|retard\w*)\b', re.I)
+
+
+def normalized(text):
+    return unicodedata.normalize('NFKC', text).casefold().translate(str.maketrans({'0':'o','1':'i','3':'e','4':'a','5':'s','7':'t','@':'a','$':'s'}))
+
+
+def birth_date(value):
+    try:
+        result = datetime.date.fromisoformat(str(value))
+    except ValueError:
+        raise ValueError('Enter a valid birth date: YYYY-MM-DD.') from None
+    if not datetime.date(1900, 1, 1) <= result <= datetime.date.today():
+        raise ValueError('Enter a valid birth date.')
+    return result.isoformat()
+
+
+class SocialStore:
+    def init_social(self):
+        columns = {r['name'] for r in self.db.execute('PRAGMA table_info(accounts)')}
+        for name, declaration in [('birth_date','TEXT'),('color','INTEGER DEFAULT 0'),('tagline',"TEXT DEFAULT 'Pick up a fight'"),('play_seconds','INTEGER DEFAULT 0'),('chat_strikes','INTEGER DEFAULT 0'),('chat_strike_at','REAL DEFAULT 0'),('muted_until','REAL DEFAULT 0')]:
+            if name not in columns:
+                self.db.execute(f'ALTER TABLE accounts ADD COLUMN {name} {declaration}')
+        self.db.executescript('''
+        CREATE TABLE IF NOT EXISTS friendships(sender TEXT,recipient TEXT,state TEXT,created REAL,PRIMARY KEY(sender,recipient));
+        CREATE TABLE IF NOT EXISTS blocks(owner TEXT,target TEXT,PRIMARY KEY(owner,target));
+        CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT,sender TEXT,recipient TEXT,body TEXT,created REAL,profanity INTEGER DEFAULT 0);
+        CREATE INDEX IF NOT EXISTS conversation ON messages(sender,recipient,id);
+        CREATE TABLE IF NOT EXISTS social_events(actor TEXT,kind TEXT,created REAL);
+        CREATE TABLE IF NOT EXISTS invitations(id INTEGER PRIMARY KEY AUTOINCREMENT,sender TEXT,recipient TEXT,address TEXT,expires REAL);
+        CREATE TABLE IF NOT EXISTS reports(id INTEGER PRIMARY KEY AUTOINCREMENT,reporter TEXT,message INTEGER,reason TEXT,created REAL,UNIQUE(reporter,message));
+        CREATE TABLE IF NOT EXISTS moderation(id INTEGER PRIMARY KEY AUTOINCREMENT,account TEXT,reason TEXT,action TEXT,created REAL);
+        ''')
+        self.db.commit()
+
+    def chat_eligible(self, aid):
+        row = self.db.execute('SELECT birth_date FROM accounts WHERE id=?',(aid,)).fetchone()
+        if not row or not row['birth_date']:
+            return False
+        dob = datetime.date.fromisoformat(row['birth_date'])
+        today = datetime.date.today()
+        return today.year-dob.year-((today.month,today.day)<(dob.month,dob.day)) >= 14
+
+    def social_profile(self, result, owner):
+        aid = result['id']
+        muted_until = result['muted_until']
+        age_known = bool(result['birth_date'])
+        for key in ('birth_date','chat_strikes','chat_strike_at','muted_until'):
+            result.pop(key, None)
+        if owner:
+            result['age_recorded'] = age_known
+            result['chat_eligible'] = self.chat_eligible(aid)
+            result['muted_until'] = muted_until
+        return result
+
+    def is_blocked(self, a, b):
+        return bool(self.db.execute('SELECT 1 FROM blocks WHERE (owner=? AND target=?) OR (owner=? AND target=?)',(a,b,b,a)).fetchone())
+
+    def friends(self, a, b):
+        return not self.is_blocked(a,b) and bool(self.db.execute("SELECT 1 FROM friendships WHERE state='accepted' AND ((sender=? AND recipient=?) OR (sender=? AND recipient=?))",(a,b,b,a)).fetchone())
+
+    def target(self, data, aid):
+        row = self.db.execute('SELECT id FROM accounts WHERE name=?',(str(data.get('name','')).strip(),)).fetchone()
+        if not row or row['id']==aid:
+            raise ValueError('Choose another existing player.')
+        return row['id']
+
+    def social_limit(self, aid, kind, count, seconds):
+        now=time.time()
+        with self.db:
+            self.db.execute('DELETE FROM social_events WHERE created<?',(now-86400,))
+            used=self.db.execute('SELECT COUNT(*) FROM social_events WHERE actor=? AND kind=? AND created>?',(aid,kind,now-seconds)).fetchone()[0]
+            if used>=count:
+                raise ValueError('Too many requests. Try again later.')
+            self.db.execute('INSERT INTO social_events VALUES(?,?,?)',(aid,kind,now))
+
+    def chat_violation(self, aid, reason):
+        now=time.time()
+        a=self.db.execute('SELECT chat_strikes,chat_strike_at FROM accounts WHERE id=?',(aid,)).fetchone()
+        strikes=(a['chat_strikes'] if now-a['chat_strike_at']<86400 else 0)+1
+        duration=0 if strikes==1 else min(86400,600*3**min(strikes-2,5))
+        with self.db:
+            self.db.execute('UPDATE accounts SET chat_strikes=?,chat_strike_at=?,muted_until=? WHERE id=?',(strikes,now,now+duration if duration else 0,aid))
+            self.db.execute('INSERT INTO moderation(account,reason,action,created) VALUES(?,?,?,?)',(aid,reason,'warning' if not duration else f'mute:{duration}',now))
+        return dict(ok=False,error=(f'Warning: {reason}. Message not sent. Another violation will restrict chat.' if not duration else f'Chat restricted for {duration//60} minutes: {reason}.'),warning=not bool(duration),muted_until=now+duration if duration else 0)
+
+    def social_route(self, path, data, aid):
+        now=time.time()
+        if path=='/profile/update':
+            color=data.get('color',0); tagline=data.get('tagline',TAGLINES[0])
+            if type(color) is not int or not 0<=color<8 or tagline not in TAGLINES:
+                raise ValueError('Choose an available color and player motto.')
+            with self.db: self.db.execute('UPDATE accounts SET color=?,tagline=? WHERE id=?',(color,tagline,aid))
+            return dict(ok=True,profile=self.profile(aid,True))
+        if path=='/profile/age':
+            row=self.db.execute('SELECT birth_date FROM accounts WHERE id=?',(aid,)).fetchone()
+            if row['birth_date']: raise ValueError('Birth date is already recorded and cannot be changed here.')
+            value=birth_date(data.get('birth_date'))
+            with self.db: self.db.execute('UPDATE accounts SET birth_date=? WHERE id=?',(value,aid))
+            return dict(ok=True,profile=self.profile(aid,True))
+        if path=='/profile/view':
+            other=self.target(data,aid)
+            if self.is_blocked(aid,other): raise ValueError('Player unavailable.')
+            return dict(ok=True,profile=self.profile(other))
+        if path=='/social':
+            rows=self.db.execute('SELECT * FROM friendships WHERE sender=? OR recipient=?',(aid,aid)).fetchall()
+            accepted=[]; incoming=[]; outgoing=[]
+            for row in rows:
+                other=row['recipient'] if row['sender']==aid else row['sender']
+                if self.is_blocked(aid,other): continue
+                p=self.profile(other)
+                if row['state']=='accepted': accepted.append(p)
+                elif row['recipient']==aid: incoming.append(p)
+                else: outgoing.append(p)
+            with self.db: self.db.execute('DELETE FROM invitations WHERE expires<?',(now,))
+            invites=[dict(id=r['id'],name=r['name'],address=r['address'],expires=r['expires']) for r in self.db.execute('SELECT i.*,a.name FROM invitations i JOIN accounts a ON a.id=i.sender WHERE recipient=? ORDER BY i.id DESC LIMIT 20',(aid,)) if not self.is_blocked(aid,r['sender'])]
+            blocked=[r['name'] for r in self.db.execute('SELECT a.name FROM blocks b JOIN accounts a ON a.id=b.target WHERE b.owner=?',(aid,))]
+            return dict(ok=True,friends=accepted,incoming=incoming,outgoing=outgoing,invites=invites,blocked=blocked,profile=self.profile(aid,True))
+        if path in ('/friends/request','/friends/accept','/friends/remove','/block','/unblock'):
+            other=self.target(data,aid)
+            if path=='/block':
+                with self.db:
+                    self.db.execute('INSERT OR IGNORE INTO blocks VALUES(?,?)',(aid,other))
+                    self.db.execute('DELETE FROM friendships WHERE (sender=? AND recipient=?) OR (sender=? AND recipient=?)',(aid,other,other,aid))
+                    self.db.execute('DELETE FROM invitations WHERE (sender=? AND recipient=?) OR (sender=? AND recipient=?)',(aid,other,other,aid))
+                return dict(ok=True)
+            if path=='/unblock':
+                with self.db: self.db.execute('DELETE FROM blocks WHERE owner=? AND target=?',(aid,other))
+                return dict(ok=True)
+            if self.is_blocked(aid,other): raise ValueError('Player unavailable.')
+            if path=='/friends/remove':
+                with self.db: self.db.execute('DELETE FROM friendships WHERE (sender=? AND recipient=?) OR (sender=? AND recipient=?)',(aid,other,other,aid))
+            elif path=='/friends/accept':
+                row=self.db.execute("SELECT 1 FROM friendships WHERE sender=? AND recipient=? AND state='pending'",(other,aid)).fetchone()
+                if not row: raise ValueError('No incoming request from that player.')
+                with self.db: self.db.execute("UPDATE friendships SET state='accepted' WHERE sender=? AND recipient=?",(other,aid))
+            else:
+                self.social_limit(aid,'friend',10,3600)
+                row=self.db.execute('SELECT 1 FROM friendships WHERE (sender=? AND recipient=?) OR (sender=? AND recipient=?)',(aid,other,other,aid)).fetchone()
+                if row: raise ValueError('A friendship or request already exists.')
+                for account in (aid,other):
+                    count=self.db.execute('SELECT COUNT(*) FROM friendships WHERE sender=? OR recipient=?',(account,account)).fetchone()[0]
+                    if count>=200: raise ValueError('Friend list is full.')
+                with self.db: self.db.execute("INSERT INTO friendships VALUES(?,?,'pending',?)",(aid,other,now))
+            return dict(ok=True)
+        if path=='/invite/send':
+            other=self.target(data,aid)
+            if not self.friends(aid,other): raise ValueError('Accept the friend request before sending invites.')
+            address=str(data.get('address','')).removeprefix('arena://').strip()
+            match=re.fullmatch(r'([A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?):([0-9]{1,5})',address)
+            if ABUSE.search(normalized(address).replace('.', ' ').replace('-', ' ')) or PROFANITY.search(normalized(address).replace('.', ' ').replace('-', ' ')):
+                raise ValueError('Choose an appropriate host address.')
+            if not match or not 1<=int(match[2])<=65535: raise ValueError('Use a host address and port, such as knivra.ca:27844.')
+            self.social_limit(aid,'invite',5,60)
+            with self.db:
+                self.db.execute('DELETE FROM invitations WHERE expires<? OR (sender=? AND recipient=?)',(now,aid,other))
+                self.db.execute('INSERT INTO invitations(sender,recipient,address,expires) VALUES(?,?,?,?)',(aid,other,address,now+600))
+            return dict(ok=True)
+        if path=='/invite/dismiss':
+            with self.db: self.db.execute('DELETE FROM invitations WHERE id=? AND recipient=?',(int(data.get('id',0)),aid))
+            return dict(ok=True)
+        if path in ('/chat/send','/chat/read'):
+            other=self.target(data,aid)
+            if not self.chat_eligible(aid) or not self.chat_eligible(other): raise ValueError('Chat is available only when both accounts are age 14 or older.')
+            if not self.friends(aid,other): raise ValueError('Chat requires an accepted friendship. Blocked players cannot chat.')
+            if path=='/chat/read':
+                rows=self.db.execute('SELECT m.id,a.name,m.body,m.created FROM messages m JOIN accounts a ON a.id=m.sender WHERE (sender=? AND recipient=?) OR (sender=? AND recipient=?) ORDER BY m.id DESC LIMIT 50',(aid,other,other,aid)).fetchall()
+                return dict(ok=True,messages=[dict(r) for r in reversed(rows)])
+            account=self.db.execute('SELECT muted_until FROM accounts WHERE id=?',(aid,)).fetchone()
+            if account['muted_until']>now: return dict(ok=False,error='Chat is temporarily restricted. Please wait.',muted_until=account['muted_until'])
+            text=str(data.get('text','')).strip()
+            if not 1<=len(text)<=280 or any(unicodedata.category(c).startswith('C') for c in text): raise ValueError('Send 1–280 characters without control characters.')
+            recent=self.db.execute('SELECT body,created,profanity FROM messages WHERE sender=? AND created>?',(aid,now-60)).fetchall()
+            if sum(r['created']>now-10 for r in recent)>=5 or any(normalized(r['body'])==normalized(text) for r in recent):
+                return self.chat_violation(aid,'spam or repeated messages')
+            clean=normalized(text)
+            compact=re.sub(r'(?<=\w)[.*_-](?=\w)','',clean)
+            if ABUSE.search(clean) or ABUSE.search(compact): return self.chat_violation(aid,'abusive language')
+            count=max(len(PROFANITY.findall(clean)),len(PROFANITY.findall(compact)))
+            if count>=3 or (count and sum(r['profanity'] for r in recent)>=2): return self.chat_violation(aid,'repeated profanity')
+            # Replace the whole message if obfuscation prevents safe token-level masking.
+            filtered=PROFANITY.sub('****',text) if PROFANITY.search(text) else ('[language filtered]' if count else text)
+            with self.db:
+                self.db.execute('DELETE FROM messages WHERE created<?',(now-30*86400,))
+                self.db.execute('INSERT INTO messages(sender,recipient,body,created,profanity) VALUES(?,?,?,?,?)',(aid,other,filtered,now,count))
+            return dict(ok=True,filtered=bool(count))
+        if path=='/chat/report':
+            mid=int(data.get('id',0)); reason=data.get('reason','harassment')
+            if reason not in ('harassment','spam','inappropriate'): raise ValueError('Choose a report reason.')
+            row=self.db.execute('SELECT * FROM messages WHERE id=? AND recipient=?',(mid,aid)).fetchone()
+            if not row: raise ValueError('Only received messages can be reported.')
+            self.social_limit(aid,'report',10,3600)
+            with self.db: self.db.execute('INSERT OR IGNORE INTO reports(reporter,message,reason,created) VALUES(?,?,?,?)',(aid,mid,reason,now))
+            return dict(ok=True)
+        return None
