+        with self.assertRaises(ValueError): self.call('/matches/start',{'mode':'DEATHMATCH','proofs':[proof]},self.b)
+
+    def test_solo_cannot_award_xp(self):
+        with self.assertRaises(ValueError): self.call('/matches/start',{'mode':'DEATHMATCH','proofs':[]})
+        with self.assertRaises(ValueError): self.call('/matches/start',{'mode':'PLAYER vs AI','proofs':[]})
+
+    def test_scores_rank_unlocks_and_style_persist(self):
+        mid=self.match(); reply=self.call('/matches/finish',self.results(mid))
+        self.assertEqual(reply['profile']['xp'],1300)
