+import datetime
+import os
+import sqlite3
+import tempfile
+import time
+import unittest
+from server import Store
+
+
+class SocialTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory(); self.path=os.path.join(self.temp.name,'social.sqlite3')
+        self.store=Store(self.path,server_key='trusted-test-key-which-is-long-enough')
+        self.a=self.signup('Alpha','2000-01-01'); self.b=self.signup('Bravo','2001-01-01'); self.child=self.signup('Junior',datetime.date.today().replace(year=datetime.date.today().year-10).isoformat())
+        self.call('/friends/request',{'name':'Bravo'}); self.call('/friends/accept',{'name':'Alpha'},self.b)
+    def tearDown(self):
+        self.store.db.close(); self.temp.cleanup()
+    def signup(self,name,dob=None):
+        return self.store.route('/signup',dict(name=name,password='test-password',birth_date=dob))
+    def call(self,path,data=None,actor=None):
+        return self.store.route(path,data or {},(actor or self.a)['token'])
+    def test_private_birth_date_and_moderation_never_in_public_profile(self):
+        for p in self.call('/leaderboard')['players']:
+            for key in ('birth_date','chat_strikes','chat_strike_at','muted_until','age_recorded','chat_eligible','password','salt'):
+                self.assertNotIn(key,p)
+        self.assertTrue(self.a['profile']['chat_eligible']); self.assertFalse(self.child['profile']['chat_eligible'])
+    def test_child_can_friend_and_receive_invites_but_never_chat(self):
+        self.call('/friends/request',{'name':'Junior'}); self.call('/friends/accept',{'name':'Alpha'},self.child)
+        self.call('/invite/send',{'name':'Junior','address':'knivra.ca:27844'})
+        self.assertEqual(len(self.call('/social',actor=self.child)['invites']),1)
+        for actor,target in [(self.a,'Junior'),(self.child,'Alpha')]:
+            for path in ('/chat/send','/chat/read'):
+                with self.assertRaisesRegex(ValueError,'14'): self.call(path,{'name':target,'text':'hello'},actor)
+        self.assertEqual(self.store.db.execute('SELECT COUNT(*) FROM messages').fetchone()[0],0)
+    def test_age_boundary_and_immutable_birth_date(self):
+        today=datetime.date.today(); birthday=today.replace(year=today.year-14)
+        exact=self.signup('Fourteen',birthday.isoformat()); self.assertTrue(exact['profile']['chat_eligible'])
+        almost=self.signup('Almost',(birthday+datetime.timedelta(days=1)).isoformat()); self.assertFalse(almost['profile']['chat_eligible'])
+        with self.assertRaises(ValueError): self.call('/profile/age',{'birth_date':'1990-01-01'},self.child)
+        with self.assertRaises(ValueError): self.signup('Future','2099-01-01')
+    def test_legacy_accounts_fail_closed_until_age_recorded(self):
+        legacy=self.signup('Legacy'); self.assertFalse(legacy['profile']['chat_eligible'])
+        updated=self.call('/profile/age',{'birth_date':'2000-01-01'},legacy); self.assertTrue(updated['profile']['chat_eligible'])
+    def test_chat_requires_accepted_friendship_and_authenticated_user(self):
+        outsider=self.signup('Outside','1990-01-01')
+        with self.assertRaises(ValueError): self.call('/chat/send',{'name':'Alpha','text':'hello'},outsider)
+        with self.assertRaises(ValueError): self.store.route('/chat/send',{'name':'Bravo','text':'hello'})
+        self.call('/chat/send',{'name':'Bravo','text':'Good game!'})
+        self.assertEqual(self.call('/chat/read',{'name':'Alpha'},self.b)['messages'][0]['body'],'Good game!')
+    def test_filter_warn_mute_and_restart_persistence(self):
+        self.assertTrue(self.call('/chat/send',{'name':'Bravo','text':'that was shit'})['filtered'])
+        self.assertEqual(self.call('/chat/read',{'name':'Alpha'},self.b)['messages'][0]['body'],'that was ****')
+        first=self.call('/chat/send',{'name':'Bravo','text':'kill yourself'})
+        self.assertTrue(first['warning']); self.assertFalse(first['ok'])
+        second=self.call('/chat/send',{'name':'Bravo','text':'kys'})
+        self.assertGreater(second['muted_until'],time.time())
+        self.store.db.close(); self.store=Store(self.path)
+        self.a=self.store.route('/login',dict(name='Alpha',password='test-password'))
+        self.assertFalse(self.call('/chat/send',{'name':'Bravo','text':'another message'})['ok'])
+        self.assertEqual(self.store.db.execute('SELECT COUNT(*) FROM messages').fetchone()[0],1)
+    def test_spam_warning_then_restriction(self):
+        self.call('/chat/send',{'name':'Bravo','text':'hello'})
+        self.assertTrue(self.call('/chat/send',{'name':'Bravo','text':'hello'})['warning'])
+        self.assertGreater(self.call('/chat/send',{'name':'Bravo','text':'hello'})['muted_until'],time.time())
+    def test_chat_burst_limit_and_excessive_profanity(self):
+        for i in range(5): self.assertTrue(self.call('/chat/send',{'name':'Bravo','text':f'line {i}'})['ok'])
+        self.assertTrue(self.call('/chat/send',{'name':'Bravo','text':'line six'})['warning'])
+        self.assertTrue(self.call('/chat/send',{'name':'Alpha','text':'shit fuck bitch'},self.b)['warning'])
+    def test_block_stops_requests_chat_invites_and_hides_history(self):
+        self.call('/chat/send',{'name':'Bravo','text':'hello'})
+        self.call('/block',{'name':'Alpha'},self.b)
+        for path,data in [('/friends/request',{'name':'Bravo'}),('/chat/read',{'name':'Bravo'}),('/chat/send',{'name':'Bravo','text':'hi'}),('/invite/send',{'name':'Bravo','address':'knivra.ca:27844'})]:
+            with self.assertRaises(ValueError): self.call(path,data)
+        self.assertFalse(self.call('/social')['friends'])
+    def test_report_requires_received_message_and_is_idempotent(self):
+        self.call('/chat/send',{'name':'Bravo','text':'hello'})
+        mid=self.call('/chat/read',{'name':'Alpha'},self.b)['messages'][0]['id']
+        with self.assertRaises(ValueError): self.call('/chat/report',{'id':mid})
+        for _ in range(2): self.call('/chat/report',{'id':mid},self.b)
+        self.assertEqual(self.store.db.execute('SELECT COUNT(*) FROM reports').fetchone()[0],1)
+    def test_profile_customization_validated_and_no_rank_mutation(self):
+        p=self.call('/profile/update',{'color':6,'tagline':'Mall menace','xp':999999})['profile']
+        self.assertEqual(p['color'],6); self.assertEqual(p['tagline'],'Mall menace'); self.assertEqual(p['xp'],0)
+        with self.assertRaises(ValueError): self.call('/profile/update',{'color':99})
+    def test_invites_scoped_expire_and_cannot_contain_free_text(self):
+        with self.assertRaises(ValueError): self.call('/invite/send',{'name':'Bravo','address':'hello there'})
+        self.call('/invite/send',{'name':'Bravo','address':'knivra.ca:27844'})
+        self.assertFalse(self.call('/social')['invites'])
+        row=self.call('/social',actor=self.b)['invites'][0]
+        self.call('/invite/dismiss',{'id':row['id']})
+        self.assertEqual(len(self.call('/social',actor=self.b)['invites']),1)
+        with self.store.db: self.store.db.execute('UPDATE invitations SET expires=0')
+        self.assertFalse(self.call('/social',actor=self.b)['invites'])
+    def test_cannot_accept_own_friend_request(self):
+        self.call('/friends/request',{'name':'Junior'})
+        with self.assertRaises(ValueError): self.call('/friends/accept',{'name':'Junior'})
+    def test_untrusted_hosts_cannot_forge_ranked_scores(self):
+        casual=self.call('/matches/start',{'mode':'DEATHMATCH','proofs':[]})
+        self.assertFalse(casual['ranked']); self.assertEqual(casual['match_id'],'')
+        for key in ('','fake'):
+            with self.assertRaises(ValueError): self.store.route('/matches/finish',{'match_id':'invented'},self.a['token'],server_key=key)
+        self.assertEqual(self.call('/me')['profile']['xp'],0)
+    def test_friend_request_rate_limit(self):
+        for _ in range(9):
+            self.call('/friends/request',{'name':'Junior'}); self.call('/friends/remove',{'name':'Junior'})
+        with self.assertRaises(ValueError): self.call('/friends/request',{'name':'Junior'})
+
+
+class MigrationTests(unittest.TestCase):
+    def test_existing_database_migrates_without_destroying_stats(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path=os.path.join(folder,'old.sqlite3'); db=sqlite3.connect(path)
+            db.execute("CREATE TABLE accounts(id TEXT PRIMARY KEY,name TEXT UNIQUE COLLATE NOCASE,salt TEXT,password TEXT,xp INTEGER DEFAULT 0,kills INTEGER DEFAULT 0,deaths INTEGER DEFAULT 0,wins INTEGER DEFAULT 0,matches INTEGER DEFAULT 0,cosmetic TEXT DEFAULT 'standard',ranged INTEGER DEFAULT 0,melee INTEGER DEFAULT 0)")
+            db.execute("INSERT INTO accounts(id,name,xp) VALUES('old','Veteran',4000)"); db.commit(); db.close()
+            store=Store(path); p=store.profile('old',True)
+            self.assertEqual(p['xp'],4000); self.assertEqual(p['rank'],5); self.assertFalse(p['chat_eligible']); store.db.close()
+
