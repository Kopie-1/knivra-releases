+#!/usr/bin/env python3
+"""Install Build 25 with checksum verification and automatic file rollback.
+Run --check without privileges to validate the release before installation.
+"""
+import datetime,hashlib,json,os,pathlib,shutil,subprocess,sys,time,urllib.request
+HERE=pathlib.Path(__file__).resolve().parent
+PACK=pathlib.Path('/opt/knivra-public/server.pck')
+ALLOC=pathlib.Path('/opt/knivra-server/AccountServer/matchmaking.py')
+DROP=pathlib.Path('/etc/systemd/system/knivra-accounts.service.d/build25.conf')
+PUBLIC_DROP=pathlib.Path('/etc/systemd/system/knivra-public.service.d/build25.conf')
+def run(*args):subprocess.run(args,check=True)
+def atomic(src,dst):
+ dst.parent.mkdir(parents=True,exist_ok=True)
+ tmp=dst.with_name(dst.name+'.build25-new');shutil.copyfile(src,tmp);tmp.chmod(0o644);os.replace(tmp,dst)
+def main():
+ expected=json.loads((HERE/'checksums.json').read_text())
+ for name,digest in expected.items():
+  if hashlib.sha256((HERE/name).read_bytes()).hexdigest()!=digest:sys.exit('Checksum mismatch: '+name)
+ if '--check' in sys.argv:print('Build 25 installer payload checksums verified.');return
+ if os.geteuid()!=0:sys.exit('Administrator access required. Run this installer with sudo.')
+ for path in [PACK,ALLOC]:
+  if not path.is_file():sys.exit('Existing deployment not found: '+str(path))
+ stamp=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
+ backup=pathlib.Path('/var/backups/knivra-build25')/stamp;backup.mkdir(parents=True,mode=0o700);backup.parent.chmod(0o700)
+ targets=[(HERE/'server25.pck',PACK),(HERE/'matchmaking.py',ALLOC),(HERE/'accounts-build25.conf',DROP),(HERE/'arena-build25.conf',PUBLIC_DROP)]
+ existing={}
+ for i,(_,dest) in enumerate(targets):
+  existing[str(dest)]=dest.exists()
+  if dest.exists():shutil.copy2(dest,backup/str(i))
+ (backup/'files.json').write_text(json.dumps(existing,indent=2))
+ try:
+  run('systemctl','stop','knivra-public.service','knivra-accounts.service')
+  for src,dest in targets:atomic(src,dest)
+  run('systemctl','daemon-reload');run('systemctl','start','knivra-accounts.service');run('systemctl','start','knivra-public.service')
+  time.sleep(6)
+  for service in ['knivra-accounts.service','knivra-public.service']:run('systemctl','is-active','--quiet',service)
+  with urllib.request.urlopen('http://127.0.0.1:27845/health',timeout=10) as response:
+   if not json.load(response).get('ok'):raise RuntimeError('Account health check failed')
+ except BaseException:
+  for i,(_,dest) in enumerate(targets):
+   if existing[str(dest)]:atomic(backup/str(i),dest)
+   elif dest.exists():dest.unlink()
